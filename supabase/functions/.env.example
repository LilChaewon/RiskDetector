# Copy this file to a private .env file and deploy with:
#   supabase secrets set --env-file supabase/functions/.env.production

CORS_ALLOWED_ORIGINS=https://riskdetectorpeuronteuendeu.onrender.com,http://localhost:3000,http://localhost:3001

AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_SESSION_TOKEN=
AWS_S3_BUCKET=risk-detector-myongji
AWS_LAMBDA_OCR_FUNCTION=detector_ocr_lambda
AWS_LAMBDA_ANALYSIS_FUNCTION=detector_bedrock_lambda

# Optional when Supabase's default secret key env is unavailable.
# Never expose this in Render frontend environment variables.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

